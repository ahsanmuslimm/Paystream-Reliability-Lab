{
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "showLegend": true } },
      "targets": [
        {
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "title": "Consumer group lag (total)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "showLegend": true } },
      "targets": [
        {
          "expr": "max by (consumergroup, topic) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}} / {{topic}}"
        }
      ],
      "title": "Lag by group and topic (max partition)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "showLegend": true } },
      "targets": [
        {
          "expr": "kafka_consumergroup_members",
          "legendFormat": "{{consumergroup}}"
        }
      ],
      "title": "Active members per group (D3 rebalance storm indicator)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "showLegend": true } },
      "targets": [
        {
          "expr": "kafka_consumer_fetch_manager_records_lag_max{job=\"notifier\"}",
          "legendFormat": "notifier max partition lag"
        },
        {
          "expr": "kafka_consumer_fetch_manager_records_lag_max{job=\"fraud-detector\"}",
          "legendFormat": "fraud-detector max partition lag"
        }
      ],
      "title": "Micrometer consumer lag (service-side view)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "title": "PayStream - Consumer Groups",
  "uid": "paystream-consumer-groups"
